# Copy this file to .env and fill in your values

# Neon Postgres connection string (get from Neon dashboard)
NEONDB_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Groq API key — used for AI intent classification on canvas text.
# Get a free key at https://console.groq.com/keys
# Optional: if absent, the server falls back to keyword-based classification.
GROQ_API_KEY=

# Optional: override the default Groq model (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Server port (Render sets this automatically; use 8080 locally)
PORT=8080
