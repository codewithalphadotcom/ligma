{
    "name": "ligma",
    "private": true,
    "version": "0.1.0",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --filter '*' dev",
        "dev:web": "bun --filter @ligma/web dev",
        "dev:server": "bun --filter @ligma/server dev",
        "build": "bun run --filter '*' build",
        "lint": "bun run --filter '*' lint",
        "typecheck": "bun run --filter '*' typecheck"
    },
    "devDependencies": {
        "typescript": "^5.6.3",
        "@types/bun": "latest"
    },
    "packageManager": "bun@1.3.0",
    "engines": {
        "bun": ">=1.3.0"
    }
}